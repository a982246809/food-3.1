generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  MERCHANT
  ADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  COMPLETED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  dishes         Dish[]  @relation("MerchantDishes")
  ordersPlaced   Order[] @relation("StudentOrders")
  ordersReceived Order[] @relation("MerchantOrders")
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal
  description String?
  image       String?
  stock       Int      @default(0)
  merchantId  Int
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  merchant   User        @relation("MerchantDishes", fields: [merchantId], references: [id])
  orderItems OrderItem[]
}

model Order {
  id         Int         @id @default(autoincrement())
  studentId  Int
  merchantId Int
  status     OrderStatus @default(PENDING)
  total      Decimal
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  student  User        @relation("StudentOrders", fields: [studentId], references: [id])
  merchant User        @relation("MerchantOrders", fields: [merchantId], references: [id])
  items    OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  dishId    Int
  quantity  Int
  price     Decimal // Snapshot price

  // Relations
  order Order @relation(fields: [orderId], references: [id])
  dish  Dish  @relation(fields: [dishId], references: [id])
}
