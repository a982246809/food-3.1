generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  MERCHANT
  ADMIN
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  password      String
  role          Role           @default(STUDENT)
  status        String         @default("ACTIVE") // ACTIVE | PENDING | REJECTED | DISABLED
  balance       Decimal        @default(0.00) @db.Decimal(10, 2)
  canteenId     String?
  canteen       Canteen?       @relation(fields: [canteenId], references: [id])
  windowId      String?
  window        Window?        @relation(fields: [windowId], references: [id])
  orders        Order[]
  complaints    Complaint[]
  announcements Announcement[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Canteen {
  id        String   @id @default(uuid())
  name      String
  building  String?
  floor     String?
  windows   Window[]
  merchants User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Window {
  id        String   @id @default(uuid())
  canteenId String
  name      String
  canteen   Canteen  @relation(fields: [canteenId], references: [id])
  dishes    Dish[]
  orders    Order[]
  merchants User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dish {
  id        String   @id @default(uuid())
  windowId  String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  isOnSale  Boolean  @default(true)
  isSpecial Boolean  @default(false)
  imageUrl  String?
  window    Window   @relation(fields: [windowId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         String      @id @default(uuid())
  studentId  String
  windowId   String
  items      Json
  totalPrice Decimal     @db.Decimal(10, 2)
  status     OrderStatus @default(PENDING)
  pickupTime DateTime?
  remark     String?
  student    User        @relation(fields: [studentId], references: [id])
  window     Window      @relation(fields: [windowId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Complaint {
  id        String   @id @default(uuid())
  studentId String
  content   String   @db.Text
  status    String   @default("PENDING") // PENDING | PROCESSED
  reply     String?  @db.Text
  student   User     @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
